---
// Site-wide chat widget ("Ask Pazbi"). The deep-chat web component (MIT) is
// lazy-loaded on first open so it costs nothing on initial page load. Answers
// come from the Netlify function at /api/chat; booking is always one click
// away via the header button, independent of the AI.
const BOOKING_URL = 'https://zcal.co/pazbi/map';
---

<div class="cw" id="chat-widget">
  <section class="cw__panel" id="chat-panel" hidden aria-label="Chat with Pazbi's assistant">
    <header class="cw__head">
      <div class="cw__head-text">
        <p class="hud cw__hud">▸ ASK PAZBI</p>
        <p class="cw__title">Questions? I'm all ears.</p>
      </div>
      <a class="cw__book" href={BOOKING_URL} target="_blank" rel="noopener">Book a call</a>
      <button class="cw__close" type="button" aria-label="Close chat">✕</button>
    </header>

    <div class="cw__chips" id="chat-chips">
      <button type="button" data-q="What do you do?">What do you do?</button>
      <button type="button" data-q="How much do workshops cost?">Workshop pricing</button>
      <button type="button" data-q="I'd like to book a call with Pazbi.">Book a call</button>
    </div>

    <div class="cw__body" id="chat-body">
      <p class="cw__loading" id="chat-loading">Waking the assistant…</p>
    </div>

    <p class="cw__note">AI assistant — it can slip up. Prefer a human? <a href={`mailto:hello@thepazbi.com`}>hello@thepazbi.com</a></p>
  </section>

  <button
    class="cw__fab"
    id="chat-fab"
    type="button"
    aria-expanded="false"
    aria-controls="chat-panel"
    aria-label="Chat with Pazbi's assistant"
  >
    <svg class="cw__icon-chat" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
    <span class="cw__icon-close" aria-hidden="true">✕</span>
  </button>
</div>

<script>
  const BOOKING_URL = 'https://zcal.co/pazbi/map';

  const widget = document.getElementById('chat-widget');
  const fab = document.getElementById('chat-fab');
  const panel = document.getElementById('chat-panel');
  const bodyEl = document.getElementById('chat-body');
  const chips = document.getElementById('chat-chips');
  const loading = document.getElementById('chat-loading');
  const closeBtn = panel?.querySelector('.cw__close');

  let chatEl: any = null;
  let loadPromise: Promise<void> | null = null;

  function loadChat(): Promise<void> {
    if (!loadPromise) {
      loadPromise = import('deep-chat').then(() => {
        const el = document.createElement('deep-chat') as any;
        el.connect = { url: '/api/chat', method: 'POST' };
        el.requestBodyLimits = { maxMessages: 12 };
        el.introMessage = {
          text: "Hello — I'm Pazbi's AI assistant. Ask me anything about his talks, workshops or consultancy, and I can point you to the diary too.",
        };
        el.errorMessages = {
          displayServiceErrorMessages: false,
          overrides: {
            default: `I've hit a snag. Email hello@thepazbi.com, or book directly: ${BOOKING_URL}`,
          },
        };
        el.messageStyles = {
          default: {
            shared: {
              bubble: {
                maxWidth: '85%',
                borderRadius: '14px',
                fontSize: '0.92rem',
                lineHeight: '1.5',
                padding: '0.55em 0.9em',
              },
            },
            user: { bubble: { backgroundColor: '#ffd400', color: '#1c1815' } },
            ai: { bubble: { backgroundColor: '#ece2cf', color: '#1c1815' } },
            loading: { message: { styles: { bubble: { backgroundColor: '#ece2cf' } } } },
          },
        };
        el.textInput = {
          styles: {
            container: {
              borderRadius: '999px',
              border: '1px solid rgba(28, 24, 21, 0.25)',
              backgroundColor: '#ffffff',
              boxShadow: 'none',
              width: 'calc(100% - 1.6rem)',
            },
            text: { color: '#1c1815', padding: '0.55em 1em' },
          },
          placeholder: { text: 'Ask about talks, workshops, pricing…', style: { color: '#6e6256' } },
        };
        el.style.cssText =
          'width:100%;height:100%;border:none;background:#fbf7ee;font-family:inherit;display:block;';
        loading?.remove();
        bodyEl?.appendChild(el);
        chatEl = el;
      });
    }
    return loadPromise;
  }

  function setOpen(open: boolean) {
    if (!widget || !fab || !panel) return;
    widget.dataset.open = String(open);
    fab.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
    if (open) loadChat();
  }

  fab?.addEventListener('click', () => setOpen(widget?.dataset.open !== 'true'));
  // Warm the bundle on hover so first open feels instant.
  fab?.addEventListener('pointerenter', () => loadChat(), { once: true });
  closeBtn?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && widget?.dataset.open === 'true') setOpen(false);
  });

  chips?.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-q]') as HTMLButtonElement | null;
    if (!btn) return;
    await loadChat();
    try {
      chatEl?.submitUserMessage({ text: btn.dataset.q });
    } catch {
      chatEl?.submitUserMessage(btn.dataset.q);
    }
    chips.remove();
  });
</script>

<style>
  .cw {
    position: fixed;
    right: clamp(1rem, 2.5vw, 1.5rem);
    bottom: clamp(1rem, 2.5vw, 1.5rem);
    z-index: 1100;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.9rem;
  }

  /* — Floating button — */
  .cw__fab {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    border: none;
    background: var(--canary);
    color: var(--ink);
    display: grid;
    place-items: center;
    cursor: pointer;
    box-shadow: 0 6px 24px rgba(28, 24, 21, 0.28);
    transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .cw__fab:hover { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(28, 24, 21, 0.32); }
  .cw__icon-close { display: none; font-size: 1.15rem; font-weight: 700; }
  .cw[data-open='true'] .cw__icon-chat { display: none; }
  .cw[data-open='true'] .cw__icon-close { display: block; }

  /* — Panel — */
  /* The display:flex below would otherwise override the browser's built-in
     [hidden] → display:none, leaving the panel stuck open. */
  .cw__panel[hidden] { display: none; }

  .cw__panel {
    width: min(400px, calc(100vw - 2rem));
    height: min(620px, calc(100dvh - 7.5rem));
    display: flex;
    flex-direction: column;
    background: var(--cream);
    border: 1px solid var(--line-light);
    border-radius: var(--radius-lg);
    box-shadow: 0 18px 48px rgba(28, 24, 21, 0.3);
    overflow: hidden;
  }

  .cw__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    background: var(--ink-2);
    color: var(--cream);
    border-bottom: 3px solid var(--canary);
  }
  .cw__head-text { flex: 1; min-width: 0; }
  .cw__hud {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: var(--canary);
    margin: 0;
  }
  .cw__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.02rem;
    margin: 0.15rem 0 0;
    line-height: 1.15;
  }
  .cw__book {
    flex-shrink: 0;
    background: var(--canary);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.45rem 0.75rem;
    border-radius: var(--radius-pill);
    transition: background 0.2s var(--ease);
  }
  .cw__book:hover { background: #ffe14d; }
  .cw__close {
    flex-shrink: 0;
    background: none;
    border: none;
    color: var(--graphite-light);
    font-size: 0.95rem;
    cursor: pointer;
    padding: 0.3rem;
    line-height: 1;
  }
  .cw__close:hover { color: var(--cream); }

  /* — Quick chips — */
  .cw__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0.7rem 0.9rem 0;
  }
  .cw__chips button {
    background: var(--bone);
    border: 1px solid var(--line-light);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 0.78rem;
    padding: 0.35rem 0.7rem;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: background 0.15s var(--ease);
  }
  .cw__chips button:hover { background: var(--canary); }

  .cw__body { flex: 1; min-height: 0; }
  .cw__loading {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    text-align: center;
    padding-top: 2.5rem;
  }

  .cw__note {
    margin: 0;
    padding: 0.45rem 0.9rem 0.6rem;
    font-size: 0.68rem;
    color: var(--muted);
    text-align: center;
  }
  .cw__note a { color: var(--canary-deep); font-weight: 600; }
  .cw__note a:hover { text-decoration: underline; }

  @media (max-width: 480px) {
    .cw__panel { height: min(560px, calc(100dvh - 6.5rem)); }
  }

  @media print {
    .cw { display: none; }
  }
</style>
